# Set these in Vercel project Settings > Environment Variables, not in Git.
# Use a NEW dedicated Supabase project, never the existing HRD project.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
PORTFOLIO_ADMIN_USER_ID=YOUR_AUTH_USER_UUID
# Must remain false until import, security verification, and publish tests pass.
PORTFOLIO_CMS_ENABLED=false
