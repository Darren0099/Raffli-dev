# GitHub-backed Raffli CMS — only add real values in Vercel project settings.
# Never commit this file with populated secrets or prefix any with NEXT_PUBLIC_.
GITHUB_TOKEN=YOUR_FINE_GRAINED_GITHUB_TOKEN
GITHUB_CMS_BRANCH=main
CMS_ADMIN_USERNAME=YOUR_ADMIN_USERNAME
CMS_ADMIN_PASSWORD_HASH=YOUR_SCRYPT_SALT_COLON_HEX_HASH
CMS_SESSION_SECRET=YOUR_RANDOM_32_PLUS_CHARACTER_SECRET
# Keep false before importing and validating existing projects.
PORTFOLIO_CMS_ENABLED=false
